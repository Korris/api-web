<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>False</GenerateDocumentationFile>
        <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
        <UserSecretsId>96399765-2db9-41f4-b551-3ada5161d500</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AutoMapper" Version="14.0.0" />
        <PackageReference Include="Grpc.AspNetCore" Version="2.70.0" />
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Common\Mcsg.Common.Domain\Mcsg.Common.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protos\Clients\favorite_view.proto" GrpcServices="Client" />
        <Protobuf Include="Protos\Clients\social.proto" GrpcServices="Client" />
        <Protobuf Include="Protos\Clients\social_sub.proto" GrpcServices="Client" />
        <Protobuf Include="Protos\Clients\tracking_social_share.proto" GrpcServices="Client" />
        <Protobuf Include="Protos\Clients\tracking_summary.proto" GrpcServices="Client" />
        <Protobuf Include="Protos\Clients\wallet.proto" GrpcServices="Client" />
    </ItemGroup>

</Project>
