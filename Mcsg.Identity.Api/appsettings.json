{
    "ConnectionStrings": {
        "McsgConnectionString": "Server={DbServer};Database={DbName};Port={DbPort};User Id={DbUser};Password={DbPassword};"
    },
    "Queue": {
        "Notification": {
            "Exchange": "notification.exchange",
            "QueueEmail": "notification.queue.email",
            "QueueSms": "notification.queue.sms",
            "RoutingKey": "notification.queue.*"
        }
    },
    "SmtpSettings": {
        "SmtpHost": "smtp.gmail.com",
        "SmtpUser": "",
        "SmtpFrom": "",
        "SmtpPass": "",
        "SmtpPort": 587
    },
    "OtpSetting": {
        "ExpiryInMinutes": 2,
        "OtpLength": 6,
        "OtpTokenLength": 20
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
