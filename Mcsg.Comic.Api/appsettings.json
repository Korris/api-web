{
    "ConnectionStrings": {
        "McsgConnectionString": "Server={DbServer};Database={DbName};Port={DbPort};User Id={DbUser};Password={DbPassword};MaxPoolSize=100;MinPoolSize=10;ConnectionLifetime=300;"
    },
    "Queue": {
        "Notification": {
            "Exchange": "notification.exchange",
            "QueuePostReact": "notification.queue.postreact",
            "QueueSmartLookup": "notification.queue.smartlookup",
            "QueueSyncData": "notification.queue.syncdata",
            "QueueViewHistory": "notification.queue.viewhistory",
            "RoutingKey": "notification.queue.*"
        }
    },
    "TodayTrending": {
        "Days": 7,
        "FetchDataTimes": 4
    },
    "DefaultUser": {
        "SystemProfileName": "BlogTruyen",
        "SystemProfileId": "BlogTruyen",
        "SystemAvatar": "default"
    },
    "FeedDisplayConfigs": {
        "PremiumPackage": 100,
        "Trending": 3,
        "ComicRecommended": 20
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
