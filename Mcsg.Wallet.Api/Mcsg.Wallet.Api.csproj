<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>False</GenerateDocumentationFile>
        <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.AspNetCore" Version="2.66.0" />
        <PackageReference Include="Otp.NET" Version="1.4.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lib\Mcsg.Lib.Common.Web\Mcsg.Lib.Common.Web.csproj" />
        <ProjectReference Include="..\Mcsg.Wallet.Domain\Mcsg.Wallet.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="..\Mcsg.Identity.Api\Protos\identity.proto" GrpcServices="Client" />
        <Protobuf Include="Protos\wallet.proto" GrpcServices="Server" />
    </ItemGroup>

</Project>
